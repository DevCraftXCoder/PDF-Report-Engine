{
  "name": "pdf-report-engine",
  "version": "0.1.0",
  "description": "Dual Python + Node.js PDF report generation engine — ReportLab backend, React UI",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "components",
    "types"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:python": "cd python && python -m pytest tests/ -v",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^29.7.0",
    "@jest/types": "^29.7.0",
    "ts-jest": "^29.2.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pdf",
    "report",
    "reportlab",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "Frxncois (DevCraftXCoder)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevCraftXCoder/PDF-Report-Engine.git"
  }
}
